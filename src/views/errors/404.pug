extends /layouts/adminlte4.pug

block content
    .content.d-flex.flex-column.align-items-center.justify-content-center.py-5(min-height='60vh')
        .text-center
            h1.text-primary.fw-bold.mb-0(style='font-size: 8rem; line-height: 1;') 404
            h3.mt-3.mb-2
                i.bi.bi-compass.me-2
                | 页面未找到
            p.text-muted.mb-4 抱歉，您访问的页面不存在或已被移动
            .d-flex.gap-2.justify-content-center
                a.btn.btn-primary(href='/')
                    i.bi.bi-house.me-1
                    | 返回首页
                button.btn.btn-outline-secondary(type='button' onclick='history.back()')
                    i.bi.bi-arrow-left.me-1
                    | 返回上一页