extends /layouts/adminlte4.pug

block content
    .content.d-flex.flex-column.align-items-center.justify-content-center.py-5(min-height='60vh')
        .text-center
            h1.text-warning.fw-bold.mb-0(style='font-size: 8rem; line-height: 1;') 409
            h3.mt-3.mb-2
                i.bi.bi-arrow-repeat.me-2
                | 数据冲突
            p.text-muted.mb-4= message || '提交的数据与现有记录存在冲突，请检查后重试'
            .d-flex.gap-2.justify-content-center
                button.btn.btn-primary(type='button' onclick='history.back()')
                    i.bi.bi-arrow-left.me-1
                    | 返回修改