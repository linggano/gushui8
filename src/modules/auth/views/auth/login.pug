doctype html
html(lang="zh-CN")
    head
        title= title || '登录'
        meta(http-equiv="Content-Type" content="text/html; charset=utf-8")
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet" href="/npm/@fontsource/open-sans/index.css")
        link(rel="stylesheet" href="/npm/overlayscrollbars/styles/overlayscrollbars.min.css")
        link(rel="stylesheet" href="/npm/bootstrap-icons/font/bootstrap-icons.min.css")
        link(rel="stylesheet" href="/npm/adminlte4/dist/css/adminlte.min.css")
    body(class="login-page bg-body-secondary")
        .login-box
            .login-logo
                a(href="/")
                    img(src="/npm/adminlte4/dist/assets/img/AdminLTEFullLogo.png" alt="AdminLTE Logo" class="brand-image brand-image-lg brand d-block")

            .card
                div(class="card-body login-card-body")
                    p(class="login-box-msg") 登录
                    
                    if error && error.length
                        div(class="alert alert-danger alert-dismissible fade show mb-3")
                            button(type="button", class="btn-close", data-bs-dismiss="alert")
                            ul(class="mb-0")
                                each err in error
                                    li= err
                    
                    form(method="post")
                        input(type='hidden' name='_csrf' value=csrfToken)
                        .input-group.mb-3
                            input.form-control(type="text" name="identifier" placeholder="用户名或邮箱" required value=(oldData && oldData.identifier) || '')
                            .input-group-text
                                span(class="bi bi-envelope")
                                span(class="bi bi-cursor-text")
                                span(class="bi bi-person")
                        .input-group.mb-3
                            input.form-control(type="password" name="password_hash" placeholder="密码" required)
                            .input-group-text
                                span(class="bi bi-lock")
                        .input-group.mb-3
                            input.form-control(type="text" name="captcha" placeholder="验证码" required maxlength="4")
                            .input-group-text.p-0
                                if captchaImage
                                    div(id="captchaImage" style="cursor: pointer; width: 120px; height: 38px; display: flex; align-items: center; justify-content: center; background: #f5f5f5;")
                                        != captchaImage
                        .row
                            .col-8
                                input(class="form-check-input" type="checkbox" name="remember" id="remember")
                                label(class="form-check-label" for="remember") &nbsp; 记住我
                            .col-4
                                .d-grid.gap-2
                                    button(class="btn btn-primary" type="submit") 登录

                    .social-auth-links.text-center.mb-3.d-grid.gap-2
                        p - OR -
                    
                    p.mb-1
                        a(href="/auth/forgot-password" class="text-center") 忘记密码？

                    p(class="mb-0") 需要账号？
                        a(href="javascript:void(0)" class="text-center" title="请联系 HR 获取邀请链接") 联系 HR

        script(nonce=nonce, src="/npm/overlayscrollbars/browser/overlayscrollbars.browser.es6.min.js")
        script(nonce=nonce, src="/npm/@popperjs/core/dist/umd/popper.min.js")
        script(nonce=nonce, src="/npm/bootstrap/dist/js/bootstrap.bundle.min.js")
        script(nonce=nonce, src="/npm/adminlte4/dist/js/adminlte.min.js")
        script(
          nonce=nonce,  
          crossorigin="anonymous"
        ).
            const SELECTOR_SIDEBAR_WRAPPER = '.sidebar-wrapper';
            const Default = {
                scrollbarTheme: 'os-theme-light',
                scrollbarAutoHide: 'leave',
                scrollbarClickScroll: true,
            };
            
            // 获取验证码
            function loadCaptcha() {
                fetch('/auth/captcha')
                    .then(response => response.json())
                    .then(data => {
                        const captchaDiv = document.getElementById('captchaImage');
                        if (captchaDiv && data.svg) {
                            captchaDiv.innerHTML = data.svg;
                        }
                    })
                    .catch(error => {
                        console.error('Failed to load captcha:', error);
                    });
            }
            
            document.addEventListener('DOMContentLoaded', function () {
                const sidebarWrapper = document.querySelector(SELECTOR_SIDEBAR_WRAPPER);

                // Disable OverlayScrollbars on mobile devices to prevent touch interference
                const isMobile = window.innerWidth <= 992;

                if (
                sidebarWrapper &&
                OverlayScrollbarsGlobal?.OverlayScrollbars !== undefined &&
                !isMobile
                ) {
                OverlayScrollbarsGlobal.OverlayScrollbars(sidebarWrapper, {
                    scrollbars: {
                    theme: Default.scrollbarTheme,
                    autoHide: Default.scrollbarAutoHide,
                    clickScroll: Default.scrollbarClickScroll,
                    },
                });
                }
                
                // 点击验证码刷新
                const captchaDiv = document.getElementById('captchaImage');
                if (captchaDiv) {
                    captchaDiv.style.cursor = 'pointer';
                    captchaDiv.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        loadCaptcha();
                    });
                }
            });