# .env.example

# ============================================
# 应用基本配置
# ============================================
NODE_ENV=development
PORT=3000
APP_NAME=Page Express Service
APP_URL=http://localhost:3000

# 本地 HTTPS 开发支持（可选）
HTTPS_ENABLED=false
HTTPS_PORT=8443
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
APP_SECRET=your-app-secret-key-change-this-in-production
APP_TIMEZONE=Asia/Shanghai

# ============================================
# 数据库配置
# ============================================
DATABASE_DIALECT=sqlite
DATABASE_STORAGE=database/erp-express.sqlite
DATABASE_LOGGING=true
DATABASE_POOL_MAX=5
DATABASE_POOL_MIN=0
DATABASE_POOL_ACQUIRE=30000
DATABASE_POOL_IDLE=10000

# ============================================
# 会话和Cookie配置
# ============================================
SESSION_SECRET=your-session-secret-key-change-this-in-production
SESSION_NAME=sid
SESSION_MAX_AGE=604800000
SESSION_HTTP_ONLY=true
SESSION_SECURE=false
SESSION_SAME_SITE=strict

COOKIE_SECRET=your-cookie-secret-key-change-this-in-production
COOKIE_DOMAIN=localhost
COOKIE_PATH=/

# ============================================
# 安全配置
# ============================================
CSRF_SECRET=your-csrf-secret-key-change-this-in-production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5

# ============================================
# 密码策略
# ============================================
PASSWORD_MIN_LENGTH=6
PASSWORD_SALT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ============================================
# 文件上传
# ============================================
UPLOAD_MAX_SIZE=5242880
UPLOAD_DIR=uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=5
LOG_ENABLE_CONSOLE=true
LOG_ENABLE_FILE=false

# ============================================
# 分页配置
# ============================================
PAGINATION_DEFAULT_LIMIT=10
PAGINATION_MAX_LIMIT=1000

# ============================================
# 密码重置
# ============================================
PASSWORD_RESET_EXPIRY=86400000
PASSWORD_RESET_TOKEN_LENGTH=32